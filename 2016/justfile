root_dir := justfile_directory()
gradle_flags := "--offline --quiet"
template_dir := root_dir / "template"

# Compile main sources. Incremental: reuses Gradle build cache.
build:
    cd "{{root_dir}}" && ./gradlew {{gradle_flags}} compileKotlin

# Run all day test suites, or one day: just test 1. Exits non-zero if any fail.
test day='':
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{root_dir}}"
    if [ -n "{{day}}" ]; then
        day_padded=$(printf '%02d' "{{day}}")
        ./gradlew --offline test "--tests" "Day${day_padded}Test"
    else
        ./gradlew --offline test
    fi

# Run a solution: just run 1 p2 --test
run day *args:
    cd "{{root_dir}}" && ./gradlew {{gradle_flags}} run "--args={{day}} {{args}}"

# Scaffold a new day from template/: just new 7
new day:
    #!/usr/bin/env bash
    set -euo pipefail
    day_num="{{day}}"
    case "$day_num" in
        ''|*[!0-9]*) echo "Usage: just new <day number, e.g. 7>"; exit 1;;
    esac
    day_padded=$(printf '%02d' "$day_num")
    target="{{root_dir}}/day-$day_padded"
    if [ -e "$target" ]; then echo "day-$day_padded already exists"; exit 1; fi
    cp -R "{{template_dir}}/day-XX" "$target"
    mv "$target/DayXX.kt" "$target/Day${day_padded}.kt"
    mv "$target/DayXXTest.kt" "$target/Day${day_padded}Test.kt"
    sed -i '' -e "s/DayXX/Day${day_padded}/g" -e "s/day-XX/day-$day_padded/g" -e "s/Day XX/Day ${day_num}/g" \
        "$target/Day${day_padded}.kt" "$target/Day${day_padded}Test.kt"
    aoc -y 2016 -d "$day_num" download -I -i "$target/input.in"
    aoc -y 2016 -d "$day_num" read
    echo "Created $target. Register it in src/Main.kt."

# Remove all Gradle build output.
clean:
    cd "{{root_dir}}" && ./gradlew {{gradle_flags}} clean
