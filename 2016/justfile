kotlinc_version := "2.4.21"

root_dir := justfile_directory()
build_dir := root_dir / "build"
common_src := root_dir / "common/src"
main_src := root_dir / "src/main"
days_src := root_dir / "day-*"
template_dir := root_dir / "template"

# Compile all sources to build/. Incremental: reuses build/ if present.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{build_dir}}"
    srcs=$(find "{{common_src}}" "{{main_src}}" {{days_src}} -name '*.kt' ! -name '*_test.kt' 2>/dev/null)
    kotlinc $srcs -include-runtime -d "{{build_dir}}/aoc2016.jar" >/dev/null

# Compile and run every day's test suite. Exits non-zero if any fail.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    just build >/dev/null
    declare -a test_classes=()
    for f in $(find {{days_src}} -name '*Test.kt' 2>/dev/null | sort); do
        rel="${f#{{root_dir}}/}"
        cls="${rel##*src/}"; cls="${cls%.kt}"; cls="${cls//\//.}"
        test_classes+=("$cls")
    done
    rm -rf "{{build_dir}}/tests"
    kotlinc $(find "{{common_src}}" {{days_src}} -name '*.kt' ! -name '*Test.kt' ! -path '*template*') \
            $(find {{days_src}} -name '*Test.kt') \
            -d "{{build_dir}}/tests" >/dev/null
    status=0
    for cls in "${test_classes[@]}"; do
        kotlin -classpath "{{build_dir}}/tests" "${cls}Kt" || status=1
    done
    exit $status

# Run a solution: just run 1 p2 --test
run day *args:
    #!/usr/bin/env bash
    set -euo pipefail
    just build >/dev/null
    java -cp "{{build_dir}}/aoc2016.jar" main.MainKt "{{day}}" {{args}}

# Scaffold a new day from template/: just new 7
new day:
    #!/usr/bin/env bash
    set -euo pipefail
    day_num="{{day}}"
    case "$day_num" in
        ''|*[!0-9]*) echo "Usage: just new <day number, e.g. 7>"; exit 1;;
    esac
    day_padded=$(printf '%02d' "$day_num")
    target="{{root_dir}}/day-$day_padded"
    if [ -e "$target" ]; then echo "day-$day_padded already exists"; exit 1; fi
    cp -R "{{template_dir}}/day-XX" "$target"
    mv "$target/src/days/dayXX" "$target/src/days/day${day_padded}"
    mv "$target/src/days/day${day_padded}/DayXX.kt" "$target/src/days/day${day_padded}/Day${day_padded}.kt"
    mv "$target/src/days/day${day_padded}/DayXXTest.kt" "$target/src/days/day${day_padded}/Day${day_padded}Test.kt"
    grep -R -l 'dayXX\|DayXX\|day-XX\|Day XX' "$target" | while read -r f; do
        sed -i '' -e "s/dayXX/day${day_padded}/g" -e "s/DayXX/Day${day_padded}/g" -e "s/day-XX/day-$day_padded/g" -e "s/Day XX/Day ${day_num}/g" "$f"
    done
    echo "Created $target. Register it in src/main/Main.kt."

# Remove all build output.
clean:
    rm -rf "{{build_dir}}"
